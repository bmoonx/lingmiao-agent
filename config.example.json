{
  "_comment": "灵妙（lingmiao）配置模板。用法：复制成 config.json，放在 lingmiao 二进制同级目录、或你启动它的当前目录；改完重启生效。config.json 已进 .gitignore，不会入库——也请勿把带 key 的它提交到任何仓库。只想用内置的 DeepSeek / Kimi / Claude？只填 .env 里的 key 就够了，本文件可以不用。要加自己的模型来源、或把某个阶段指到别的模型，才需要编辑本文件。应用内输入 /help 或直接问 AI（help 工具，topic=models）可查全部字段。",

  "models": {
    "default": { "group": "deepseek", "model": "deepseek-v4-flash-vision-exp" },
    "groups": [
      {
        "id": "deepseek",
        "label": "DeepSeek",
        "protocol": "openai",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "DEEPSEEK_API_KEY",
        "models": [
          { "id": "deepseek-v4-flash-vision-exp", "label": "DeepSeek V4 Flash Vision", "supports_vision": true },
          { "id": "deepseek-v4-pro", "label": "DeepSeek V4 Pro", "thinking": true },
          { "id": "deepseek-v4-flash", "label": "DeepSeek V4 Flash" }
        ]
      },
      {
        "id": "kimi",
        "label": "Kimi for Coding",
        "protocol": "openai",
        "base_url": "https://api.kimi.com/coding/v1",
        "api_key_env": "KIMI_API_KEY",
        "models": [
          { "id": "kimi-for-coding", "label": "Kimi for Coding" }
        ]
      },
      {
        "id": "claude",
        "label": "Claude",
        "protocol": "anthropic",
        "base_url": "https://api.anthropic.com",
        "api_key_env": "CLAUDE_API_KEY",
        "models": [
          { "id": "claude-fable-5", "label": "Claude Fable 5", "supports_vision": true }
        ]
      },
      {
        "id": "zhipu",
        "label": "智谱 GLM",
        "protocol": "openai",
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "api_key_env": "ZHIPU_API_KEY",
        "models": [
          { "id": "glm-4.6", "label": "GLM-4.6" }
        ]
      }
    ]
  },

  "stages": {
    "组织上下文": { "group": "deepseek", "model": "deepseek-v4-flash" },
    "工作阶段": { "group": "deepseek", "model": "deepseek-v4-pro" },
    "沉淀阶段": { "group": "deepseek", "model": "deepseek-v4-flash" }
  }
}
